# TechMaint — variables du deploiement sur le socle partage.
# Copier en `deploy/techmaint.env` sur le VPS. NE JAMAIS COMMITTER techmaint.env.

# --- Base de donnees --------------------------------------------------------
# PostgreSQL du socle, joint par son nom de service sur le reseau `socle`.
# Npgsql, pas SQL Server : voir Program.cs.
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=techmaint;Username=techmaint;Password=<MOT_DE_PASSE>

# Applique les migrations en attente au demarrage du conteneur. L'image ne
# porte pas `dotnet ef` (outil du SDK, absent du runtime) : sans ceci, chaque
# deploiement demanderait un geste manuel depuis un poste ayant acces a la base.
RUN_MIGRATIONS_ON_BOOT=true

# --- Auth -------------------------------------------------------------------
# HS256, 32 octets minimum. L'application REFUSE de demarrer en dessous.
# Generer : openssl rand -base64 48
Jwt__Key=
Jwt__Issuer=TechMaintApi
Jwt__Audience=TechMaintClients
Jwt__ExpireMinutes=60

# --- Front ------------------------------------------------------------------
# Liste blanche CORS, separee par des virgules. Aucune valeur permissive.
Cors__AllowedOrigins=https://techmaint.soultaka.com

# --- Google Maps (optionnel) ------------------------------------------------
# Vide = geocodage et itineraires desactives, l'API repond proprement au lieu
# d'appeler Google sans cle. La cle de l'ancien projet a ete revoquee.
GoogleMaps__ApiKey=
